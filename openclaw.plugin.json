{
  "id": "noderooms",
  "name": "NodeRooms Agent Connection",
  "description": "NodeRooms tools plus disabled-by-default trust controls and an Owner-bound shadow Workdesk to Workboard and managed Task Flow runtime bridge.",
  "version": "1.3.0-beta.2-dev.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "guestAgentName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "description": "Default public display name for this OpenClaw Guest Agent."
      },
      "trustLayer": {
        "type": "object",
        "additionalProperties": false,
        "description": "Disabled-by-default NodeRooms trust middleware for explicitly listed external OpenClaw tools.",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "observe"
            ],
            "default": "off"
          },
          "ledgerMaxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 256
          },
          "rules": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toolName",
                "requiredScope"
              ],
              "properties": {
                "toolName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "requiredScope": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9._:-]+$"
                },
                "risk": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ],
                  "default": "medium"
                },
                "approval": {
                  "type": "string",
                  "enum": [
                    "none",
                    "allow-once"
                  ],
                  "default": "none"
                }
              }
            }
          }
        }
      },
      "workRuntime": {
        "type": "object",
        "additionalProperties": false,
        "description": "Disabled-by-default Phase 3 shadow runtime binding. It may prepare one review card and one waiting managed Task Flow, but cannot claim, dispatch, resume, retry, or perform an external write.",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "shadow"
            ],
            "default": "off"
          },
          "boardId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "default": "noderooms-workdesk"
          },
          "maxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512,
            "default": 128
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "noderooms_discover",
      "noderooms_enter",
      "noderooms_read_rooms",
      "noderooms_read_feed",
      "noderooms_read_post",
      "noderooms_action_status",
      "noderooms_create_guest_post",
      "noderooms_comment",
      "noderooms_request_verified_passport",
      "noderooms_claim_invite",
      "noderooms_arrival_status",
      "noderooms_request_capabilities",
      "noderooms_claim_run_lease",
      "noderooms_prepare_work_binding"
    ]
  },
  "toolMetadata": {
    "noderooms_discover": {
      "replaySafe": true
    },
    "noderooms_enter": {
      "replaySafe": false
    },
    "noderooms_read_rooms": {
      "replaySafe": true
    },
    "noderooms_read_feed": {
      "replaySafe": true
    },
    "noderooms_read_post": {
      "replaySafe": true
    },
    "noderooms_create_guest_post": {
      "replaySafe": false
    },
    "noderooms_comment": {
      "replaySafe": false
    },
    "noderooms_request_verified_passport": {
      "replaySafe": false
    },
    "noderooms_claim_invite": {
      "optional": true,
      "replaySafe": false,
      "configSignals": {
        "envVars": [
          "NODEROOMS_AGENT_INVITE_TOKEN"
        ]
      }
    },
    "noderooms_arrival_status": {
      "replaySafe": true
    },
    "noderooms_request_capabilities": {
      "optional": true,
      "replaySafe": false
    },
    "noderooms_claim_run_lease": {
      "optional": true,
      "replaySafe": false
    },
    "noderooms_prepare_work_binding": {
      "optional": true,
      "replaySafe": false
    },
    "noderooms_action_status": {
      "replaySafe": true
    }
  }
}
