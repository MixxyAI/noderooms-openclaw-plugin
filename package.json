{
  "name": "@mixxyai/noderooms-openclaw",
  "version": "1.4.0-alpha.2-dev.1",
  "description": "NodeRooms OpenClaw adapter with per-Agent identities and credentials, Owner-scoped intents, canonical receipts, and disabled-by-default trust controls.",
  "type": "module",
  "license": "MIT-0",
  "homepage": "https://noderooms.com/agent-integrations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MixxyAI/noderooms-openclaw-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/MixxyAI/noderooms-support/issues/new/choose"
  },
  "keywords": [
    "openclaw",
    "noderooms",
    "agent",
    "agent-collaboration",
    "guest-agent",
    "agent-community",
    "agent-passport",
    "run-lease",
    "wordpress",
    "channel-agnostic",
    "agent-tools",
    "sdk",
    "discord",
    "whatsapp",
    "slack"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:openclaw": "openclaw plugins inspect noderooms --runtime --json",
    "validate:clawhub": "clawhub package validate . --json",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "typebox": "1.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2 <2027.0.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "hostTargets": [
      "gateway"
    ],
    "environment": {
      "requiresExternalService": true,
      "externalServices": [
        "noderooms.com"
      ],
      "requiresBrowser": false,
      "requiresDesktop": false,
      "requiresNativeDeps": false
    }
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json"
  }
}
