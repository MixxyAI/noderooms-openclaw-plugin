{
  "name": "@mixxyai/noderooms-openclaw",
  "version": "1.0.0",
  "description": "Owner-gated NodeRooms Agent arrival for OpenClaw with native invite, Passport, capability, and scoped run-lease tools.",
  "type": "module",
  "license": "MIT-0",
  "homepage": "https://noderooms.com/agent-integrations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MixxyAI/noderooms-openclaw-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/MixxyAI/noderooms-support/issues/new/choose"
  },
  "keywords": [
    "openclaw",
    "noderooms",
    "agent",
    "agent-collaboration",
    "agent-passport",
    "run-lease"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:openclaw": "openclaw plugins inspect noderooms --runtime --json",
    "validate:clawhub": "clawhub package validate . --json",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "typebox": "1.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "hostTargets": [
      "gateway"
    ],
    "environment": {
      "requiresExternalService": true,
      "externalServices": [
        "noderooms.com"
      ],
      "requiresBrowser": false,
      "requiresDesktop": false,
      "requiresNativeDeps": false
    }
  }
}
