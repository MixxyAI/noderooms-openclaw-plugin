{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noderooms.com/contracts/artifact-runtime-fingerprint-v1.schema.json",
  "title": "NodeRooms exact artifact and runtime fingerprint result v1",
  "description": "A secret-free, evidence-only result produced by the repository-side TrustBridge 005B fingerprint engine. It grants no authority, performs no install or enforcement action, and does not claim artifact safety or external validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "fixture",
    "authority_status",
    "profiles",
    "artifact_binding",
    "package_json_sha256",
    "directory_manifest",
    "runtime_observation_manifest",
    "runtime_binding",
    "claims",
    "zero_side_effects",
    "result_fingerprint_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://noderooms.com/contracts/artifact-runtime-fingerprint-v1.schema.json"
    },
    "contract_version": {
      "const": "noderooms-artifact-runtime-fingerprint.v1"
    },
    "fixture": {
      "type": "boolean"
    },
    "authority_status": {
      "const": "evidence_only_no_authority"
    },
    "profiles": {
      "$ref": "#/$defs/profiles"
    },
    "artifact_binding": {
      "$ref": "#/$defs/artifactBinding"
    },
    "package_json_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "directory_manifest": {
      "$ref": "#/$defs/directoryManifest"
    },
    "runtime_observation_manifest": {
      "$ref": "#/$defs/runtimeObservationManifest"
    },
    "runtime_binding": {
      "$ref": "#/$defs/runtimeBinding"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "zero_side_effects": {
      "$ref": "#/$defs/zeroSideEffects"
    },
    "result_fingerprint_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 214,
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9._@/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "httpsUriWithoutQuery": {
      "type": "string",
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://[^?#]+$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[ -~]+$"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_fingerprint",
        "directory_normalization",
        "runtime_fingerprint"
      ],
      "properties": {
        "archive_fingerprint": {
          "const": "raw-artifact-bytes-sha256-v1"
        },
        "directory_normalization": {
          "const": "noderooms-portable-directory-tree-sha256-v1"
        },
        "runtime_fingerprint": {
          "const": "noderooms-runtime-observation-sha256-v1"
        }
      }
    },
    "archiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "format": {
          "enum": [
            "npm_tgz",
            "zip",
            "tar",
            "other_declared"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        }
      }
    },
    "directoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_label",
        "normalization_profile",
        "tree_fingerprint_sha256",
        "file_count"
      ],
      "properties": {
        "root_label": {
          "const": "package_root"
        },
        "normalization_profile": {
          "const": "noderooms-portable-directory-tree-sha256-v1"
        },
        "tree_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "package_version",
        "publisher_id",
        "origin_uri",
        "directory"
      ],
      "properties": {
        "package_name": {
          "$ref": "#/$defs/packageName"
        },
        "package_version": {
          "$ref": "#/$defs/version"
        },
        "publisher_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "origin_uri": {
          "$ref": "#/$defs/httpsUriWithoutQuery"
        },
        "archive": {
          "$ref": "#/$defs/archiveBinding"
        },
        "directory": {
          "$ref": "#/$defs/directoryBinding"
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "directoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "directory"
        },
        "path": {
          "$ref": "#/$defs/portablePath"
        }
      }
    },
    "directoryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_profile",
        "root_label",
        "file_count",
        "directory_count",
        "total_file_bytes",
        "entries"
      ],
      "properties": {
        "normalization_profile": {
          "const": "noderooms-portable-directory-tree-sha256-v1"
        },
        "root_label": {
          "const": "package_root"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "directory_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "total_file_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/fileEntry"
              },
              {
                "$ref": "#/$defs/directoryEntry"
              }
            ]
          }
        }
      }
    },
    "openClawObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "package_json_sha256",
        "directory_tree_fingerprint_sha256",
        "plugin_api_fingerprint_sha256"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "package_json_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "directory_tree_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plugin_api_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nodeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executable_sha256"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeBindingInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_fingerprint_sha256",
        "openclaw_agent_fingerprint_sha256",
        "runtime_key_thumbprint_sha256",
        "sanitized_config_fingerprint_sha256"
      ],
      "properties": {
        "gateway_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "openclaw_agent_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_key_thumbprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sanitized_config_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "arch",
        "environment_class"
      ],
      "properties": {
        "platform": {
          "enum": [
            "aix",
            "android",
            "darwin",
            "freebsd",
            "linux",
            "openbsd",
            "sunos",
            "win32"
          ]
        },
        "arch": {
          "enum": [
            "arm",
            "arm64",
            "ia32",
            "loong64",
            "mips",
            "mipsel",
            "ppc",
            "ppc64",
            "riscv64",
            "s390",
            "s390x",
            "x64"
          ]
        },
        "environment_class": {
          "$ref": "#/$defs/safeIdentifier"
        }
      }
    },
    "pluginObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "package_version",
        "package_directory_tree_fingerprint_sha256",
        "package_archive_sha256"
      ],
      "properties": {
        "package_name": {
          "$ref": "#/$defs/packageName"
        },
        "package_version": {
          "$ref": "#/$defs/version"
        },
        "package_directory_tree_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_archive_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtimeObservationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_profile",
        "openclaw",
        "node",
        "plugin",
        "bindings",
        "environment"
      ],
      "properties": {
        "fingerprint_profile": {
          "const": "noderooms-runtime-observation-sha256-v1"
        },
        "openclaw": {
          "$ref": "#/$defs/openClawObservation"
        },
        "node": {
          "$ref": "#/$defs/nodeObservation"
        },
        "plugin": {
          "$ref": "#/$defs/pluginObservation"
        },
        "bindings": {
          "$ref": "#/$defs/runtimeBindingInputs"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openclaw_version",
        "openclaw_plugin_api_fingerprint_sha256",
        "plugin_package_name",
        "plugin_package_version",
        "gateway_fingerprint_sha256",
        "runtime_instance_fingerprint_sha256",
        "openclaw_agent_fingerprint_sha256",
        "runtime_key_thumbprint_sha256",
        "sanitized_config_fingerprint_sha256",
        "environment_class"
      ],
      "properties": {
        "openclaw_version": {
          "$ref": "#/$defs/version"
        },
        "openclaw_plugin_api_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plugin_package_name": {
          "$ref": "#/$defs/packageName"
        },
        "plugin_package_version": {
          "$ref": "#/$defs/version"
        },
        "gateway_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_instance_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "openclaw_agent_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_key_thumbprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sanitized_config_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_class": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_bytes_exactly_hashed",
        "directory_contents_exactly_hashed",
        "archive_directory_correspondence_proven",
        "publisher_control_verified",
        "origin_content_verified",
        "runtime_observation_source_verified",
        "file_modes_included",
        "symlinks_allowed",
        "line_endings_normalized",
        "runtime_observation_exactly_fingerprinted",
        "artifact_safe_claimed",
        "execution_authority_granted",
        "production_enforcement_enabled",
        "owner_decision_automated",
        "external_validation_complete"
      ],
      "properties": {
        "archive_bytes_exactly_hashed": {
          "type": "boolean"
        },
        "directory_contents_exactly_hashed": {
          "const": true
        },
        "archive_directory_correspondence_proven": {
          "const": false
        },
        "publisher_control_verified": {
          "const": false
        },
        "origin_content_verified": {
          "const": false
        },
        "runtime_observation_source_verified": {
          "const": false
        },
        "file_modes_included": {
          "const": false
        },
        "symlinks_allowed": {
          "const": false
        },
        "line_endings_normalized": {
          "const": false
        },
        "runtime_observation_exactly_fingerprinted": {
          "const": true
        },
        "artifact_safe_claimed": {
          "const": false
        },
        "execution_authority_granted": {
          "const": false
        },
        "production_enforcement_enabled": {
          "const": false
        },
        "owner_decision_automated": {
          "const": false
        },
        "external_validation_complete": {
          "const": false
        }
      }
    },
    "zeroSideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "NODE_ROOMS_PRODUCTION_NETWORK_CALLS",
        "PUBLIC_WRITES",
        "PROVIDER_WRITES",
        "OWNER_COMMANDS",
        "LIVE_LEASE_REQUESTS",
        "GATEWAY_STARTS",
        "GATEWAY_RESTARTS",
        "CLAWHUB_PUBLISH_ATTEMPTS",
        "NPM_PUBLISH_ATTEMPTS",
        "OPENCLAW_CONFIG_WRITES",
        "ARTIFACT_INSTALL_ATTEMPTS",
        "ARTIFACT_BLOCK_ATTEMPTS"
      ],
      "properties": {
        "NODE_ROOMS_PRODUCTION_NETWORK_CALLS": {
          "const": 0
        },
        "PUBLIC_WRITES": {
          "const": 0
        },
        "PROVIDER_WRITES": {
          "const": 0
        },
        "OWNER_COMMANDS": {
          "const": 0
        },
        "LIVE_LEASE_REQUESTS": {
          "const": 0
        },
        "GATEWAY_STARTS": {
          "const": 0
        },
        "GATEWAY_RESTARTS": {
          "const": 0
        },
        "CLAWHUB_PUBLISH_ATTEMPTS": {
          "const": 0
        },
        "NPM_PUBLISH_ATTEMPTS": {
          "const": 0
        },
        "OPENCLAW_CONFIG_WRITES": {
          "const": 0
        },
        "ARTIFACT_INSTALL_ATTEMPTS": {
          "const": 0
        },
        "ARTIFACT_BLOCK_ATTEMPTS": {
          "const": 0
        }
      }
    }
  },
  "x-noderooms-contract": {
    "milestone": "005B",
    "status": "implemented and locally tested",
    "external_validation": "pending",
    "runtime_authority_granted": false,
    "production_enforcement_enabled": false,
    "stable_package_identity_modified": false
  }
}
