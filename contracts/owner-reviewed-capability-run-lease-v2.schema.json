{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noderooms:contract:owner-reviewed-capability-run-lease:v2",
  "title": "NodeRooms Owner-reviewed external capability and run lease v2",
  "oneOf": [
    {
      "$ref": "#/$defs/capabilityRequest"
    },
    {
      "$ref": "#/$defs/ownerDecision"
    },
    {
      "$ref": "#/$defs/runLease"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "agentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noderooms_agent_id",
        "passport_id",
        "owner_binding_id",
        "verified_owner_required"
      ],
      "properties": {
        "noderooms_agent_id": {
          "type": "integer",
          "minimum": 1
        },
        "passport_id": {
          "type": "string",
          "pattern": "^NRP-[0-9]{6}-AGENT$"
        },
        "owner_binding_id": {
          "type": "string",
          "pattern": "^NRPB-[A-F0-9]{24}$"
        },
        "verified_owner_required": {
          "const": true
        }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "platform",
        "gateway_id",
        "runtime_instance_id",
        "openclaw_agent_id",
        "runtime_key_thumbprint",
        "session_id",
        "run_id",
        "channel",
        "owner_sender_binding_sha256"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^nrbind_[a-f0-9]{32}$"
        },
        "platform": {
          "const": "openclaw"
        },
        "gateway_id": {
          "type": "string",
          "pattern": "^ocgw_[a-f0-9]{32}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "pattern": "^ocruntime_[a-f0-9]{32}$"
        },
        "openclaw_agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "runtime_key_thumbprint": {
          "$ref": "#/$defs/sha256"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$"
        },
        "channel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{1,63}$"
        },
        "owner_sender_binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_version",
        "policy_version",
        "profile_id",
        "scope",
        "provider",
        "connector_id",
        "connector_version",
        "tool_name",
        "tool_schema_fingerprint",
        "action",
        "resource_type",
        "risk",
        "side_effect_class",
        "approval_policy"
      ],
      "properties": {
        "registry_version": {
          "type": "string",
          "pattern": "^nrcr_[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^nrp_[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^nrscp_[a-z0-9][a-z0-9_]{2,95}$"
        },
        "scope": {
          "type": "string",
          "pattern": "^connector\\.[a-z][a-z0-9_]{1,31}\\.[a-z][a-z0-9_]{1,47}\\.[a-z][a-z0-9_]{1,47}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "connector_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
        },
        "connector_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "tool_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "tool_schema_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "resource_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "side_effect_class": {
          "enum": [
            "read",
            "write",
            "destructive",
            "admin"
          ]
        },
        "approval_policy": {
          "enum": [
            "none",
            "allow_once"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "selector",
        "selector_fingerprint_sha256"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "selector": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "selector_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "costLimit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "max_minor_units"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "max_minor_units": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          }
        }
      ]
    },
    "goalLimit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal_id",
            "objective_fingerprint_sha256"
          ],
          "properties": {
            "goal_id": {
              "type": "string",
              "pattern": "^nrgoal_[a-f0-9]{32}$"
            },
            "objective_fingerprint_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "resourceLimit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_distinct_resources",
            "selector_fingerprint_sha256"
          ],
          "properties": {
            "max_distinct_resources": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "selector_fingerprint_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttl_seconds",
        "max_actions",
        "cost_limit",
        "goal_limit",
        "resource_limit"
      ],
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cost_limit": {
          "$ref": "#/$defs/costLimit"
        },
        "goal_limit": {
          "$ref": "#/$defs/goalLimit"
        },
        "resource_limit": {
          "$ref": "#/$defs/resourceLimit"
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "fixture",
        "request_id",
        "activation_state",
        "live_enforce_allowed",
        "agent_binding",
        "runtime_binding",
        "registry_binding",
        "access_mode",
        "resource",
        "requested_limits",
        "review_state",
        "requested_at",
        "expires_at",
        "request_fingerprint_sha256"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "$comment": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "const": "noderooms-external-capability-request-v2"
        },
        "fixture": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "pattern": "^nrcapreq_[a-f0-9]{32}$"
        },
        "activation_state": {
          "const": "contract_only"
        },
        "live_enforce_allowed": {
          "const": false
        },
        "agent_binding": {
          "$ref": "#/$defs/agentBinding"
        },
        "runtime_binding": {
          "$ref": "#/$defs/runtimeBinding"
        },
        "registry_binding": {
          "$ref": "#/$defs/registryBinding"
        },
        "access_mode": {
          "enum": [
            "read",
            "write"
          ]
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "requested_limits": {
          "$ref": "#/$defs/limits"
        },
        "review_state": {
          "const": "pending_owner_review"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "fixture",
        "decision_id",
        "activation_state",
        "live_enforce_allowed",
        "request_id",
        "request_fingerprint_sha256",
        "registry_binding_fingerprint_sha256",
        "resource_selector_fingerprint_sha256",
        "decision",
        "reviewer",
        "granted_limits",
        "reason_code",
        "decided_at",
        "expires_at",
        "decision_fingerprint_sha256"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "$comment": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "const": "noderooms-owner-capability-decision-v2"
        },
        "fixture": {
          "type": "boolean"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^nrcapdec_[a-f0-9]{32}$"
        },
        "activation_state": {
          "const": "contract_only"
        },
        "live_enforce_allowed": {
          "const": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^nrcapreq_[a-f0-9]{32}$"
        },
        "request_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_binding_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resource_selector_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "enum": [
            "approved_once",
            "approved_bounded",
            "denied"
