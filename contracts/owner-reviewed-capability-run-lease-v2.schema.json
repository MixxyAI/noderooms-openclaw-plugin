          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            },
            "connector_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
            },
            "connector_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            },
            "tool_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "tool_schema_fingerprint": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "access_mode": {
          "enum": [
            "read",
            "write"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "side_effect_class": {
          "enum": [
            "read",
            "write",
            "destructive",
            "admin"
          ]
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "decision",
            "decision_id",
            "decision_fingerprint_sha256",
            "approved_by",
            "owner_binding_id",
            "decision_automated",
            "approved_at",
            "consumed"
          ],
          "properties": {
            "policy": {
              "enum": [
                "none",
                "allow_once"
              ]
            },
            "decision": {
              "enum": [
                "approved_once",
                "approved_bounded"
              ]
            },
            "decision_id": {
              "type": "string",
              "pattern": "^nrcapdec_[a-f0-9]{32}$"
