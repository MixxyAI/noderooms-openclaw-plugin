              "$ref": "#/$defs/sha256"
            },
            "approved_by": {
              "const": "verified_human_owner"
            },
            "owner_binding_id": {
              "type": "string",
              "pattern": "^NRPB-[A-F0-9]{24}$"
            },
            "decision_automated": {
              "const": false
            },
